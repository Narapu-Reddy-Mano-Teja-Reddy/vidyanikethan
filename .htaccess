RewriteEngine On

# Redirect direct requests for index.html to root /
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect direct requests for courses.html to /courses
RewriteCond %{THE_REQUEST} /courses\.html [NC]
RewriteRule ^courses\.html$ /courses [R=301,L]

# Redirect other direct requests for *.html to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Internally rewrite /courses to courses.html
RewriteRule ^courses$ courses.html [NC,L]

# Internally rewrite other clean URLs to *.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]
